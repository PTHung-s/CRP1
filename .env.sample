# OpenClaw Gateway - Environment Variables
# Rename this file to ~/.openclaw/.env and fill in your real tokens

# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token

# Canvas LMS API token (from Account > Settings > Approved Integrations)
CANVAS_API_TOKEN=12345~your-canvas-api-token-here
CANVAS_URL=https://your-canvas-instance.instructure.com

# Telegram chat ID (your numeric user ID)
TELEGRAM_CHAT_ID=your-telegram-chat-id
